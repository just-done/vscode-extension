{
  "name": "just",
  "displayName": "Just.",
  "description": "Domain names and websites for the business you are building with AI.",
  "version": "0.1.0",
  "publisher": "just",
  "license": "MIT",
  "icon": "icon.png",
  "homepage": "https://just-done.ai",
  "repository": {
    "type": "git",
    "url": "https://github.com/just-done/vscode-extension.git"
  },
  "bugs": {
    "email": "support@just-done.ai"
  },
  "pricing": "Free",
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "keywords": [
    "mcp",
    "mcp-server",
    "domains",
    "domain-names",
    "registrar",
    "website",
    "hosting",
    "publish"
  ],
  "main": "./out/extension.js",
  "activationEvents": [],
  "contributes": {
    "mcpServerDefinitionProviders": [
      {
        "id": "just-domain",
        "label": "Just Domain."
      },
      {
        "id": "just-publish",
        "label": "Just Publish."
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.101.0",
    "@vscode/vsce": "^3.6.0",
    "typescript": "^5.6.0"
  }
}
